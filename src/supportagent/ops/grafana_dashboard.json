{
 "__inputs": [
  {
   "name": "DS_PROMETHEUS",
   "label": "Prometheus",
   "type": "datasource",
   "pluginId": "prometheus",
   "pluginName": "Prometheus"
  }
 ],
 "title": "supportagent - SLOs",
 "uid": "supportagent-slo",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "tags": [
  "supportagent",
  "slo"
 ],
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "30s",
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Turn latency p95 (5m)",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 8.0
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "supportagent:turn_latency_p95_seconds:5m",
     "legendFormat": "p95",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Oldest pending approval",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 3600
       },
       {
        "color": "red",
        "value": 14400
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "supportagent_approvals_oldest_pending_age_seconds",
     "legendFormat": "age",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Kill switch (global / money)",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "supportagent_kill_switch_global",
     "legendFormat": "global",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    },
    {
     "refId": "B",
     "expr": "supportagent_kill_switch_money",
     "legendFormat": "money",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Pending approvals",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "supportagent_approvals_pending",
     "legendFormat": "pending",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "task_success: error ratio vs budget 0.05",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "supportagent:sli_error_ratio:rate5m{slo=\"task_success\"}",
     "legendFormat": "5m window",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    },
    {
     "refId": "B",
     "expr": "supportagent:sli_error_ratio:rate1h{slo=\"task_success\"}",
     "legendFormat": "1h window",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    },
    {
     "refId": "C",
     "expr": "supportagent:sli_error_ratio:rate6h{slo=\"task_success\"}",
     "legendFormat": "6h window",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    },
    {
     "refId": "D",
     "expr": "vector(0.05)",
     "legendFormat": "budget",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "turn_latency: error ratio vs budget 0.05",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 8,
    "y": 5,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "supportagent:sli_error_ratio:rate5m{slo=\"turn_latency\"}",
     "legendFormat": "5m window",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    },
    {
     "refId": "B",
     "expr": "supportagent:sli_error_ratio:rate1h{slo=\"turn_latency\"}",
     "legendFormat": "1h window",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    },
    {
     "refId": "C",
     "expr": "supportagent:sli_error_ratio:rate6h{slo=\"turn_latency\"}",
     "legendFormat": "6h window",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    },
    {
     "refId": "D",
     "expr": "vector(0.05)",
     "legendFormat": "budget",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "tool_error_rate: error ratio vs budget 0.01",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 16,
    "y": 5,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "supportagent:sli_error_ratio:rate5m{slo=\"tool_error_rate\"}",
     "legendFormat": "5m window",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    },
    {
     "refId": "B",
     "expr": "supportagent:sli_error_ratio:rate1h{slo=\"tool_error_rate\"}",
     "legendFormat": "1h window",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    },
    {
     "refId": "C",
     "expr": "supportagent:sli_error_ratio:rate6h{slo=\"tool_error_rate\"}",
     "legendFormat": "6h window",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    },
    {
     "refId": "D",
     "expr": "vector(0.01)",
     "legendFormat": "budget",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Turns by outcome",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (rate(supportagent_turns_total[5m]))",
     "legendFormat": "{{status}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Tool calls by outcome",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 8,
    "y": 12,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (outcome) (rate(supportagent_tool_calls_total[5m]))",
     "legendFormat": "{{outcome}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Cost per resolution (1h, notional USD)",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 16,
    "y": 12,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(supportagent_cost_usd_total[1h])) / sum(rate(supportagent_resolutions_total[1h]))",
     "legendFormat": "usd/resolution",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Guard-block rate (1h)",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 0,
    "y": 19,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(supportagent_tool_calls_total{outcome=\"blocked\"}[1h])) / sum(rate(supportagent_tool_calls_total[1h]))",
     "legendFormat": "blocked / calls",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Verifier verdicts",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 8,
    "y": 19,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (rate(supportagent_verifier_calls_total[15m]))",
     "legendFormat": "{{status}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ]
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Read-tool cache hits",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 16,
    "y": 19,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(supportagent_tool_cache_hits_total[5m])",
     "legendFormat": "hits/s",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ]
  }
 ],
 "templating": {
  "list": []
 }
}
