# Live models (optional - everything runs offline with the simulated backend)
ANTHROPIC_API_KEY=
SA_BACKEND=scripted            # scripted | anthropic | gemini
SA_MODEL_FAST=claude-haiku-5-5
SA_MODEL_STRONG=claude-sonnet-5-5
SA_CONFIG=full                 # baseline | +prompt_v2 | +io_guards | +tool_guards | full
SA_MCP_MODE=inprocess          # inprocess | stdio
SA_EXTRA_MCP=                  # path to a third-party MCP server config (see mcp_servers.example.json)
OTEL_EXPORTER_OTLP_ENDPOINT=   # e.g. http://localhost:4318
# Gemini backend (SA_BACKEND=gemini): put the key in the git-ignored .env, never in this file
GEMINI_API_KEY=
SA_GEMINI_RPM=15               # per-minute pacing for free-tier keys (0 = off)
# SA_MODEL_FAST=gemini-3.5-flash-lite   SA_MODEL_STRONG=gemini-3.5-flash   (when SA_BACKEND=gemini)
